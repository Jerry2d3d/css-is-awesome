{
  "$description": "DTCG v2025.10 fixture: aliases, composite colour/dimension objects, a shadow, a font family, an unmapped extra.",
  "color": {
    "text": {
      "primary": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0.06, 0.09, 0.16], "hex": "#0f172a" } },
      "secondary": { "$type": "color", "$value": "#334155" },
      "link": { "$type": "color", "$value": "{color.brand.primary}" }
    },
    "brand": {
      "primary": { "$type": "color", "$value": "#3a5fcd" },
      "primaryHover": { "$type": "color", "$value": "#2e4a99" }
    },
    "action": {
      "primary": {
        "default": { "$type": "color", "$value": "{color.brand.primary}" },
        "hover": { "$type": "color", "$value": "{color.brand.primaryHover}" },
        "active": { "$type": "color", "$value": "#1e3a8a" }
      }
    },
    "surface": { "default": { "$type": "color", "$value": "#ffffff" } },
    "extra": { "coral": { "$type": "color", "$value": "#ff6b6b" } }
  },
  "space": {
    "4": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "5": { "$type": "dimension", "$value": 24 }
  },
  "typography": {
    "font": { "body": { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] } },
    "lineHeight": { "normal": { "$type": "number", "$value": 1.5 } }
  },
  "shape": { "radius": { "md": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } } } },
  "effect": {
    "shadow": {
      "md": { "$type": "shadow", "$value": { "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 4, "unit": "px" }, "blur": { "value": 12, "unit": "px" }, "spread": { "value": 0, "unit": "px" }, "color": "#0000001f" } }
    }
  },
  "motion": {
    "duration": { "fast": { "$type": "duration", "$value": { "value": 120, "unit": "ms" } } },
    "easing": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
  },
  "z": { "modal": { "$type": "number", "$value": 1000 } }
}
